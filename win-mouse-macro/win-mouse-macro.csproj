<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>win_mouse_macro</RootNamespace>
    <AssemblyName>win-mouse-macro</AssemblyName>
    <ApplicationIcon>resources\mouse.ico</ApplicationIcon>
    <!-- Old-style .NET Framework exe projects defaulted to this; SDK-style defaults to false. -->
    <Prefer32Bit>true</Prefer32Bit>
    <!-- Assembly attributes are declared in Properties\AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="resources\record.png" />
    <Resource Include="resources\play.png" />
    <Resource Include="resources\reset.png" />
    <Resource Include="resources\mouse.ico" />
  </ItemGroup>

</Project>
